#!/bin/bash

# Project Codex CLI Orchestrator (dev)
# Usage: ./dev [command] [args]

set -e

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CDX_VENV="$PROJECT_ROOT/venv"

# Load .env variables if present
load_env() {
    if [ -f "$PROJECT_ROOT/.env" ]; then
        export $(grep -v '^#' "$PROJECT_ROOT/.env" | xargs)
    fi
}

# Ensure Python Virtual Environment
ensure_venv() {
    if [ ! -d "$CDX_VENV" ]; then
        echo "Creating Python virtual environment..."
        python3 -m venv "$CDX_VENV"
        source "$CDX_VENV/bin/activate"
        pip install --quiet -r "$PROJECT_ROOT/engine/requirements.txt"
    else
        source "$CDX_VENV/bin/activate"
    fi
}

show_help() {
    cat << EOF
Project Codex - Developer CLI

Usage:
  ./dev parse <pdf_file> [output.json]   Parse a PDF into a Codex JSON manifest
  ./dev reader                           Start the Astro Reader preview dev server
  ./dev admin                            Launch Flutter Admin Dashboard (Web release mode)
  ./dev export <manifest.json>           Package an E-book into a standalone PWA zip
  ./dev test                             Run all unit test suites (Python & Flutter)
  ./dev help                             Display this help message

Examples:
  ./dev parse receta-test.pdf manifest.json
  ./dev reader
  ./dev admin
  ./dev export manifest.json
EOF
}

case "$1" in
    parse)
        if [ -z "$2" ]; then
            echo "Error: Please specify a PDF file path."
            echo "Usage: ./dev parse <pdf_file> [output.json]"
            exit 1
        fi
        PDF_PATH="$2"
        OUT_PATH="${3:-manifest.json}"
        ensure_venv
        export PYTHONPATH="$PROJECT_ROOT/engine:$PYTHONPATH"
        echo "Parsing PDF '$PDF_PATH' -> '$OUT_PATH'..."
        python3 -m codex_engine.main "$PDF_PATH" --output "$OUT_PATH" --pretty
        echo "Successfully generated $OUT_PATH"
        ;;

    reader)
        echo "Starting Astro Reader Dev Server..."
        cd "$PROJECT_ROOT/reader"
        if [ ! -d "node_modules" ]; then
            echo "Installing Node dependencies..."
            npm install --legacy-peer-deps
        fi
        if [ -f "$PROJECT_ROOT/manifest.json" ]; then
            cp "$PROJECT_ROOT/manifest.json" src/fixtures/mock_manifest.json
        fi
        npm run dev
        ;;

    admin)
        echo "Launching Flutter Admin Dashboard (Fast Web Release Mode)..."
        load_env
        cd "$PROJECT_ROOT/admin"
        flutter pub get
        flutter run -d chrome --release \
          --dart-define=NEXT_PUBLIC_SUPABASE_URL="$NEXT_PUBLIC_SUPABASE_URL" \
          --dart-define=NEXT_PUBLIC_SUPABASE_ANON_KEY="$NEXT_PUBLIC_SUPABASE_ANON_KEY"
        ;;

    export)
        if [ -z "$2" ]; then
            echo "Error: Please specify a manifest JSON file."
            echo "Usage: ./dev export <manifest.json>"
            exit 1
        fi
        MANIFEST_PATH="$2"
        chmod +x "$PROJECT_ROOT/scripts/export_pwa.sh"
        "$PROJECT_ROOT/scripts/export_pwa.sh" "$MANIFEST_PATH"
        ;;

    test)
        echo "--- Running Engine Tests ---"
        ensure_venv
        export PYTHONPATH="$PROJECT_ROOT/engine:$PYTHONPATH"
        pytest "$PROJECT_ROOT/engine/tests"

        echo "--- Running Admin Flutter Tests ---"
        cd "$PROJECT_ROOT/admin"
        flutter test
        ;;

    help|--help|-h|"")
        show_help
        ;;

    *)
        echo "Unknown command: $1"
        show_help
        exit 1
        ;;
esac
